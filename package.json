{
  "name": "@jellify-music/react-native-reanimated-slider",
  "version": "0.5.1",
  "description": "A reusable slider component for React Native, powered by React Native Gesture Handler and Reanimated.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun run --cwd example start",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "example:ios": "bun run --cwd example ios",
    "example:android": "bun run --cwd example android",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jellify-Music/react-native-reanimated-slider"
  },
  "author": "Violet Caulfield <violet@cosmonautical.cloud> (https://github.com/anultravioletaurora)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Jellify-Music/react-native-animated-slider/issues"
  },
  "homepage": "https://github.com/Jellify-Music/react-native-animated-slider#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/eslint-plugin": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.12",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "prettier": "^2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.40.17",
    "release-it": "^19.0.4",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">= 3.0.0",
    "react-native-reanimated": ">= 4.3.0",
    "react-native-worklets": ">= 0.9.1"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.3.6",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.bun|(jest-)?react-native[^/]*|@react-native(-community)?)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "react-native-reanimated/jest/resolver.js"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.56.1"
  }
}
